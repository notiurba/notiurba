# Inject variables into the process; Spring does not load this file automatically.
# Test DB must be isolated; URL must not contain embedded passwords.
SPRING_PROFILES_ACTIVE=validation
TEST_DB_URL=jdbc:postgresql://YOUR-ISOLATED-HOST/neondb?sslmode=verify-full
TEST_DB_USER=
TEST_DB_PASSWORD=
# At least 32 random bytes; generate outside source control.
JWT_SECRET=
CORS_ORIGINS=http://localhost:5173
DIAGNOSTICS_ENABLED=false
PHOTO_DIAGNOSTICS_ENABLED=false
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Integration tests are selected explicitly by Maven profiles:
# -Pspatial-tests, -Pcloudinary-tests, -Pmigration-tests
# Unit tests do not load provider credentials.
