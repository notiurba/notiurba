# Copiar a .env (no se versiona) y cambiar la contraseña
POSTGRES_DB=notiurba
POSTGRES_USER=notiurba
POSTGRES_PASSWORD=cambiar-esta-contrasena

# Variables que lee el backend (configúrelas en IntelliJ: Run > Edit Configurations > Environment variables)
DB_URL=jdbc:postgresql://localhost:5433/notiurba
DB_USER=notiurba
DB_PASSWORD=cambiar-esta-contrasena
CORS_ORIGINS=http://localhost:5173
JWT_SECRET=cambiar-este-secreto-por-uno-largo-y-aleatorio
ADMIN_DEV_PASSWORD=cambiar-esta-contrasena-de-admin
GOOGLE_CLIENT_ID=000000000000-ejemplo.apps.googleusercontent.com
RECUPERACION_ENLACE=http://localhost:5173/app/nueva-contrasena
RECUPERACION_MOSTRAR_ENLACE=true

# Correo (Resend, API HTTP). RESEND_REMITENTE: solo la dirección, del dominio verificado
RESEND_API_KEY=
RESEND_REMITENTE=
# Destino de prueba. Con valor: la prueba de envío real (EnviadorCorreoResendRealTest) le escribe a esta
# dirección Y el correo de cada reporte sale a ella en vez de a la entidad (Alcaldía, empresas).
# Vacío = el correo del reporte sale a la entidad de verdad. Déjela puesta en pruebas y demos.
RESEND_PRUEBA_DESTINO=

# Fotos (Cloudinary). Las tres salen del panel de Cloudinary; el secreto no se comparte ni se sube
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
