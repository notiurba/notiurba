# Copiar a .env (no se versiona) y cambiar la contraseña
POSTGRES_DB=notiurba
POSTGRES_USER=notiurba
POSTGRES_PASSWORD=cambiar-esta-contrasena

# Variables que lee el backend (configúrelas en IntelliJ: Run > Edit Configurations > Environment variables)
DB_URL=jdbc:postgresql://localhost:5433/notiurba
DB_USER=notiurba
DB_PASSWORD=cambiar-esta-contrasena
CORS_ORIGINS=http://localhost:5173
JWT_SECRET=cambiar-este-secreto-por-uno-largo-y-aleatorio
ADMIN_DEV_PASSWORD=cambiar-esta-contrasena-de-admin
GOOGLE_CLIENT_ID=000000000000-ejemplo.apps.googleusercontent.com
RECUPERACION_ENLACE=http://localhost:5173/app/nueva-contrasena
RECUPERACION_MOSTRAR_ENLACE=true
