# Copie este archivo como .env.local (no se sube al repositorio) y ajuste los valores.

# Dirección de la API. Si no se define, usa el backend local.
# VITE_API_URL=http://localhost:8080

# true = el backend se simula con los datos de src/simulacion/ (toda la app: ciudadano y panel admin). Cuentas de prueba: ciudadano@correo.com y admin@correo.com, contraseña Clave1234.
# false (o dejar la línea comentada, como está) = todo va al backend real definido en VITE_API_URL.
# Para trabajar sin backend, quite el # de la línea de abajo.
# VITE_USAR_MOCKS=true

# ID de cliente OAuth de Google (Google Cloud > APIs y servicios > Credenciales). Activa el botón real «Continuar con Google».
# Debe ser el mismo que usa el backend (GOOGLE_CLIENT_ID) y tener http://localhost:5173 como origen autorizado.
# VITE_GOOGLE_CLIENT_ID=
